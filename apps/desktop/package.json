{
  "name": "@ppg/desktop",
  "productName": "PPG Sorong Admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PPG Sorong Admin — aplikasi desktop (EXE) pusat data admin",
  "author": "PPG Sorong",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && npm run build:electron",
    "build:electron": "vite build -c vite.electron.config.ts --mode main && vite build -c vite.electron.config.ts --mode preload",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "devDependencies": {
    "@ppg/core": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "exceljs": "^4.4.0",
    "jsdom": "^31.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "id.ppgsorong.admin",
    "productName": "PPG Sorong Admin",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "PPG Sorong Admin"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
